import Base
import ../model.bend as M
import ./symbols.bend as S

# Only these native signatures cross into the explicitly registered intrinsics.
def native(name: String, descriptor: String) -> M.Method:
  M.Method{257, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}
def native_static(name: String, descriptor: String) -> M.Method:
  M.Method{265, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}
# ACC_VARARGS (0x80) variants for MiniJRE methods Java declares with "...".
def native_varargs(name: String, descriptor: String) -> M.Method:
  M.Method{385, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}
def native_static_varargs(name: String, descriptor: String) -> M.Method:
  M.Method{393, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}
def native_protected(name: String, descriptor: String) -> M.Method:
  M.Method{260, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}
def native_protected_static(name: String, descriptor: String) -> M.Method:
  M.Method{268, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}
def native_private(name: String, descriptor: String) -> M.Method:
  M.Method{258, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}
def abs_m(name: String, descriptor: String) -> M.Method:
  M.Method{1025, name, descriptor, 8, 8, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}

def cls(name: String, parent: String, methods: +List<M.Method>) -> M.ClassFile:
  M.ClassFile{0, 52, 1, name, parent, Nil{}, [M.Unused{}], Nil{}, methods, Nil{}}

def cls_if(name: String, parent: String, interfaces: +List<String>, methods: +List<M.Method>) -> M.ClassFile:
  M.ClassFile{0, 52, 1, name, parent, interfaces, [M.Unused{}], Nil{}, methods, Nil{}}

def iface(name: String, interfaces: +List<String>, methods: +List<M.Method>) -> M.ClassFile:
  M.ClassFile{0, 52, 1537, name, "java/lang/Object", interfaces, [M.Unused{}], Nil{}, methods, Nil{}}

def standard_annotation_pool() -> +List<M.Constant>:
  [M.Unused{}, M.Utf{"Ljava/lang/annotation/Retention;"}, M.Utf{"value"},
   M.Utf{"Ljava/lang/annotation/RetentionPolicy;"}, M.Utf{"RUNTIME"},
   M.Utf{"Ljava/lang/annotation/Target;"}, M.Utf{"Ljava/lang/annotation/ElementType;"},
   M.Utf{"ANNOTATION_TYPE"}, M.Utf{"Ljava/lang/annotation/Documented;"}]

def standard_annotation_metadata() -> M.AnnotationMetadata:
  M.AnnotationMetadata{1, Nil{},
    [M.Annotation{8, Nil{}},
     M.Annotation{1, [M.AnnotationElement{2, M.AnnotationEnum{3, 4}}]},
     M.Annotation{5, [M.AnnotationElement{2, M.AnnotationArray{[M.AnnotationEnum{6, 7}]}}]}],
    Nil{}, Nil{}, None{}, Nil{}, Nil{}, Nil{}}

def annotation_iface(name: String, methods: +List<M.Method>) -> M.ClassFile:
  M.ClassFile{0, 52, 9729, name, "java/lang/Object", ["java/lang/annotation/Annotation"],
    standard_annotation_pool(), Nil{}, methods, [M.ValidatedAnnotations{standard_annotation_metadata()}]}

def enum_fields(+owner: String, names: +List<String>) -> +List<M.Field>:
  match names:
    case Nil{}: Nil{}
    case Con{name, rest}:
      M.Field{16409, name, "L" ++ owner ++ ";", 0, Nil{}} <> enum_fields(owner, rest)

def enum_class(+name: String, names: +List<String>) -> M.ClassFile:
  M.ClassFile{0, 52, 16401, name, "java/lang/Enum", Nil{}, [M.Unused{}],
    enum_fields(name, names),
    [native_static("<clinit>", "()V"), native_static("values", "()[L" ++ name ++ ";"),
     native_static("valueOf", "(Ljava/lang/String;)L" ++ name ++ ";")], Nil{}}

def exception(name: String, parent: String) -> M.ClassFile:
  cls(name, parent, [native("<init>", "()V"), native("<init>", "(Ljava/lang/String;)V")])

def exception4(name: String, parent: String) -> M.ClassFile:
  cls(name, parent, [native("<init>", "()V"), native("<init>", "(Ljava/lang/String;)V"), native("<init>", "(Ljava/lang/Throwable;)V"), native("<init>", "(Ljava/lang/String;Ljava/lang/Throwable;)V")])
def abstract_method(name: String, descriptor: String) -> M.Method:
  M.Method{1025, name, descriptor, 0, 0, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}

# Executable declares the members Method and Constructor both implement, as the
# JDK does, so calls through an Executable reference resolve.
