  [native("getParameters", "()[Ljava/lang/reflect/Parameter;"), native("getParameterCount", "()I"),
   abstract_method("getName", "()Ljava/lang/String;"), abstract_method("getModifiers", "()I"),
   abstract_method("getDeclaringClass", "()Ljava/lang/Class;"), abstract_method("getParameterTypes", "()[Ljava/lang/Class;"),
