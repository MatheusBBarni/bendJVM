   abstract_method("getTypeParameters", "()[Ljava/lang/reflect/TypeVariable;"), abstract_method("toGenericString", "()Ljava/lang/String;"),
   abstract_method("getGenericParameterTypes", "()[Ljava/lang/reflect/Type;"), abstract_method("getGenericExceptionTypes", "()[Ljava/lang/reflect/Type;")]

